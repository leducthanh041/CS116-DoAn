    "cold_pop_alpha": 0.8,
    "cold_pop_beta": 0.2,
    "use_implicit": true,
    "top_k_model": 120,
    "K_tfidf": 90,
    "K_cosine": 90,
    "w_tfidf": 0.5,
    "w_cosine": 0.5,
    "n_trend": 20,
    "trend_source": "global_30d"
  },
  "stage2": {
    "num_leaves": 31,
    "learning_rate": 0.05,
    "n_estimators": 200,
    "min_data_in_leaf": 50
  },
  "evaluation": {
    "k_metric": 10
