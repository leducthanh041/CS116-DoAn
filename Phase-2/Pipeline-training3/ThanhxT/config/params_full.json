{
  "paths": {
    "raw_data_path": "/datastore/uittogether/LuuTru/Thanhld/CS116-DoAn/Phase-2/Pipeline-training3/Thanh/data/preprocessed-dataset-news",
    "artifacts_dir": "./artifacts_full",
    "stage1_model_path": "./artifacts_full/stage1_model.pkl",
    "stage2_model_path": "./artifacts_full/stage2_model.txt"
  },
  "data_split": {
    "hist_end_date": "2024-12-31",
